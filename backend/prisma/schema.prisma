generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  id          String            @id @default(uuid())
  email       String            @unique
  password    String
  nombre      String
  sueldo      Sueldo?
  servicios   Servicio[]
  metas       Meta[]
  gastos      Gasto[]
  categorias  Categoria[]
  comidas     Comida[]
  gimnasio    Gimnasio[]
  ahorros     Ahorro[]
  deudas      Deuda[]
  recurrentes ReglaRecurrente[]
  cuentas     Cuenta[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Sueldo {
  id        String   @id @default(uuid())
  usuarioId String   @unique
  monto     Decimal  @db.Decimal(12, 2)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Servicio {
  id             String   @id @default(uuid())
  usuarioId      String
  nombre         String
  montoDestinado Decimal  @db.Decimal(12, 2)
  usuario        Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([usuarioId])
}

model Meta {
  id            String   @id @default(uuid())
  usuarioId     String
  nombre        String
  montoObjetivo Decimal  @db.Decimal(12, 2)
  montoMensual  Decimal  @db.Decimal(12, 2)
  prioritaria   Boolean  @default(false)
  usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([usuarioId])
}

model Gasto {
  id          String   @id @default(uuid())
  usuarioId   String
  descripcion String
  monto       Decimal  @db.Decimal(12, 2)
  categoria   String
  cuentaId    String?
  fecha       DateTime @default(now())
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([usuarioId])
  @@index([cuentaId])
}

model Categoria {
  id        String   @id @default(uuid())
  usuarioId String
  nombre    String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([usuarioId, nombre])
  @@index([usuarioId])
}

model Comida {
  id          String   @id @default(uuid())
  usuarioId   String
  descripcion String
  monto       Decimal  @db.Decimal(12, 2)
  cuentaId    String?
  fecha       DateTime @default(now())
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([usuarioId])
  @@index([cuentaId])
}

model Gimnasio {
  id        String   @id @default(uuid())
  usuarioId String
  actividad String
  monto     Decimal  @db.Decimal(12, 2)
  cuentaId  String?
  fecha     DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([usuarioId])
  @@index([cuentaId])
}

model Ahorro {
  id        String   @id @default(uuid())
  usuarioId String
  nombre    String
  objetivo  Decimal  @db.Decimal(12, 2)
  actual    Decimal  @db.Decimal(12, 2) @default(0)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([usuarioId])
}

model Deuda {
  id             String   @id @default(uuid())
  usuarioId      String
  nombre         String
  direccion      String
  montoTotal     Decimal  @db.Decimal(12, 2)
  cantidadCuotas Int
  frecuencia     String
  primeraFecha   DateTime
  cuotas         Cuota[]
  usuario        Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([usuarioId])
}

model Cuota {
  id               String   @id @default(uuid())
  deudaId          String
  numero           Int
  fechaVencimiento DateTime
  monto            Decimal  @db.Decimal(12, 2)
  estado           String   @default("pendiente")
  deuda            Deuda    @relation(fields: [deudaId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@unique([deudaId, numero])
  @@index([deudaId])
}

model ReglaRecurrente {
  id          String       @id @default(uuid())
  usuarioId   String
  concepto    String
  monto       Decimal      @db.Decimal(12, 2)
  categoria   String?
  frecuencia  String
  intervalo   Int          @default(1)
  fechaInicio DateTime
  fechaFin    DateTime?
  estado      String       @default("activa")
  ocurrencias Ocurrencia[]
  usuario     Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([usuarioId])
}

model Ocurrencia {
  id        String          @id @default(uuid())
  reglaId   String
  fecha     DateTime
  estado    String          @default("pendiente")
  regla     ReglaRecurrente @relation(fields: [reglaId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@unique([reglaId, fecha])
  @@index([reglaId])
}

model Cuenta {
  id           String   @id @default(uuid())
  usuarioId    String
  nombre       String
  tipo         String
  saldoInicial Decimal  @db.Decimal(12, 2) @default(0)
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([usuarioId])
}
